# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=rands-api
APP_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database (PostgreSQL) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rands
DB_PASSWORD=rands_secret
DB_NAME=rands_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ────────────────────────────────────────────────
# If SMTP is not configured, verification and reset links are logged in development.
MAIL_FROM=no-reply@rands.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FRONTEND_BASE_URL=http://localhost:3001

# ─── Paystack ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

# ─── Throttle ─────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Market identity ───────────────────────────────────────────
# Set ONCE at deploy time per market instance.
# DO NOT change these on a live database with existing ledger entries,
# orders, or payment records — every financial record stores its currency
# at creation time and cannot be retroactively migrated.
# To launch in a new country, provision a new server + database.
PLATFORM_CURRENCY=NGN
PLATFORM_COUNTRY_CODE=NG
PLATFORM_MARKET_NAME=Nigeria
PLATFORM_NAME=Rands

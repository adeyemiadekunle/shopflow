# Application
NODE_ENV=development
PORT=3000
APP_NAME=rands-api
APP_BASE_URL=http://localhost:3000
SWAGGER_ENABLED=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rands
DB_PASSWORD=rands_secret
DB_NAME=rands_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_32_chars_min
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Email / SMTP
# If SMTP is not configured, verification and reset links are logged in development.
MAIL_FROM=no-reply@rands.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FRONTEND_BASE_URL=http://localhost:3001

# Media storage (AWS S3 + CloudFront)
AWS_REGION=eu-west-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_PRESIGN_EXPIRES_IN_SECONDS=900
MEDIA_ALLOW_VIDEO_UPLOADS=false

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

MONNIFY_API_KEY=MK_TEST_xxxxxxxxxxxxxxxxxxxx
MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx
MONNIFY_CONTRACT_CODE=xxxxxxxxxx
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Throttle
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Queue / Workers
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
QUEUE_PAYMENTS_CONCURRENCY=5
QUEUE_ORDERS_CONCURRENCY=5
QUEUE_SELLER_QUOTE_REMINDER_DELAY_MS=3600000
QUEUE_SELLER_QUOTE_EXPIRY_DELAY_MS=86400000
QUEUE_BUYER_QUOTE_REMINDER_DELAY_MS=21600000
QUEUE_BUYER_QUOTE_EXPIRY_DELAY_MS=172800000
QUEUE_PAYMENTS_RECONCILIATION_INTERVAL_MS=900000
QUEUE_PAYMENTS_RECONCILIATION_MIN_AGE_MS=600000
QUEUE_PAYMENTS_RECONCILIATION_BATCH_SIZE=100
QUEUE_REMOVE_ON_COMPLETE_AGE_SECONDS=86400
QUEUE_REMOVE_ON_COMPLETE_COUNT=1000
QUEUE_REMOVE_ON_FAIL_AGE_SECONDS=604800
QUEUE_REMOVE_ON_FAIL_COUNT=5000

# Market identity
# Set ONCE at deploy time per market instance.
# DO NOT change these on a live database with existing ledger entries,
# orders, or payment records - every financial record stores its currency
# at creation time and cannot be retroactively migrated.
# To launch in a new country, provision a new server + database.
PLATFORM_CURRENCY=NGN
PLATFORM_COUNTRY_CODE=NG
PLATFORM_MARKET_NAME=Nigeria
PLATFORM_NAME=Rands

{
  "name": "rands",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run start:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "npm run start --workspace backend",
    "start:prod": "npm run start:prod --workspace backend",
    "build": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:migrate:revert": "npm run db:migrate:revert --workspace backend",
    "db:migration:generate": "npm run db:migration:generate --workspace backend --",
    "db:migration:create": "npm run db:migration:create --workspace backend --",
    "test": "npm run test --workspace backend",
    "verify": "npm run lint && npm run format:check && npm run test && npm run build",
    "test:e2e": "npm run test:e2e --workspace backend",
    "lint": "npm run lint:check --workspace backend",
    "lint:frontend": "npm run lint --workspace frontend",
    "format": "npm run format --workspace backend",
    "format:check": "npm run format:check --workspace backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  }
}
